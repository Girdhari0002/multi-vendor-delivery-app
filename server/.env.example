MONGO_URI=mongodb://localhost:27017/delivery_app
JWT_SECRET=change_this_to_a_long_random_string
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
PORT=5000
CLIENT_URL=http://localhost:5173

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Gmail App Password for sending forgot-password / order notification emails.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA enabled on the Gmail account).
# Leave blank to fall back to console-logging emails (dev mode).
EMAIL_USER=
EMAIL_PASS=

# Borzo courier API — used to book a pickup/drop delivery when a seller marks an order
# "shipped". Get your token from your dashboard at apitest.borzodelivery.com (test) or
# your production account. Leave blank to disable courier booking (status updates still work).
BORZO_API_TOKEN=
BORZO_API_BASE_URL=https://robotapitest-in.borzodelivery.com/api/business/1.8
BORZO_PAYMENT_METHOD=cash

NODE_ENV=development
